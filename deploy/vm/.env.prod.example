APP_ENV=prod
API_KEYS=replace-with-strong-key
DATABASE_URL=postgresql+psycopg://user:password@db-host:5432/dbname
REDIS_URL=redis://redis:6379/0
DATA_DIR=/data/jobs
MAX_PDF_MB=50
JOB_TTL_DAYS=7
CELERY_CONCURRENCY=1
LOG_LEVEL=INFO
CORS_ALLOW_ALL=true
CORS_ORIGINS=
GOOGLE_CLIENT_SECRET_FILE=client_secret.json
GOOGLE_TOKEN_FILE=token.json
# Root folder where adenda_{id}/run_{job_id}/media/{tables,images} are created.
# Since 2026-09: "Adendas" in shared drive "Traspasos" (1rb3RAn3DG_R-dsXbvWAxfUDmD1vitlwP).
# To move to another folder, see README "Migrate the Drive parent folder".
GOOGLE_DRIVE_PARENT_FOLDER_ID=your-shared-drive-folder-id
ANTHROPIC_ADENDA_VALIDACION_ICSARA_API_KEY=your-dedicated-icsara-anthropic-key
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-6
ANTHROPIC_PDF_DPI=150
